  </bpmn:collaboration>
  <bpmn:process id="find_tickets" name="find_tickets" isExecutable="true" camunda:historyTimeToLive="1000">
    <bpmn:laneSet id="LaneSet_0thilx8">
      <bpmn:lane id="Lane_1hqvt79" name="Сервис">
        <bpmn:flowNodeRef>Activity_0h5hdvn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0cdc4wh" name="Пользователь">
        <bpmn:flowNodeRef>Event_0x2uq4u</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0kdtff3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_04a64qq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1n9nzft" name="Репозитории" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_0x2uq4u" name="Любой пользователь">
      <bpmn:outgoing>Flow_03w4qjw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_0kdtff3" name="Выбор типа маршрута и ввод параметров">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="type" label="type" type="enum" defaultValue="1_way_routes">
            <camunda:value id="1_way_routes" name="1_way_routes" />
            <camunda:value id="round_trip_routes" name="round_trip_routes" />
            <camunda:value id="complex_routes" name="complex_routes" />
            <camunda:value />
          </camunda:formField>
          <camunda:formField id="parameters" label="parameters" type="string" defaultValue="{   &#34;passengerCount&#34;: 1,   &#34;serviceClass&#34;: &#34;E&#34;,   &#34;maxPrice&#34;: 1000,   &#34;maxTravelTime&#34;: 50,   &#34;numberOfTransfers&#34;: 3,   &#34;availableAirlines&#34;: [&#34;Aeroflot&#34;, &#34;Delta Air Lines&#34;, &#34;Emirates&#34;],   &#34;departureCity&#34;: &#34;Moscow&#34;,   &#34;arrivalCity&#34;: &#34;Tokyo&#34;,   &#34;departureDateStart&#34;: &#34;2025-06-20&#34;,   &#34;departureDateFinish&#34;: &#34;2025-06-20&#34;,   &#34;departureTimeStart&#34;: &#34;00:00&#34;,   &#34;departureTimeFinish&#34;: &#34;23:59&#34;,   &#34;arrivalDateStart&#34;: &#34;2025-06-20&#34;,   &#34;arrivalDateFinish&#34;: &#34;2025-06-21&#34;,   &#34;arrivalTimeStart&#34;: &#34;00:00&#34;,   &#34;arrivalTimeFinish&#34;: &#34;23:59&#34; }" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03w4qjw</bpmn:incoming>
      <bpmn:outgoing>Flow_0725nmk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_03w4qjw" sourceRef="Event_0x2uq4u" targetRef="Activity_0kdtff3" />
    <bpmn:sequenceFlow id="Flow_0725nmk" sourceRef="Activity_0kdtff3" targetRef="Activity_0h5hdvn" />
    <bpmn:dataStoreReference id="DataStoreReference_1jgennw" name="Хранилище билетов" />
