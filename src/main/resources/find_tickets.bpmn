        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${type == "1_way_routes"}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_12iwbua" sourceRef="Gateway_0woasd8" targetRef="Activity_1ezgc4w">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${type == "complex_routes"}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0iydij4" sourceRef="Gateway_0woasd8" targetRef="Activity_0yon2iz">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${type == "round_trip_routes"}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:serviceTask id="Activity_0rk7ken" name="Простой маршрут" camunda:type="external" camunda:topic="search1WayRoutes">
        <bpmn:incoming>Flow_0qlt9wf</bpmn:incoming>
        <bpmn:outgoing>Flow_0ezhv0v</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_0tufygz">
