      <bpmn:sequenceFlow id="Flow_1u3j3xh" sourceRef="Activity_1ezgc4w" targetRef="Event_1ba9x67" />
      <bpmn:sequenceFlow id="Flow_0ezhv0v" sourceRef="Activity_0rk7ken" targetRef="Event_1ba9x67" />
